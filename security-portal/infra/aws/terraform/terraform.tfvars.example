aws_region   = "ap-northeast-2"
project_name = "security-portal"
environment  = "test"

create_new_network = true
availability_zones = ["ap-northeast-2a", "ap-northeast-2c"]
vpc_cidr           = "10.70.0.0/16"
enable_nat_gateway = true

allowed_ingress_cidrs = ["0.0.0.0/0"]
alb_internal          = false
desired_count         = 0

# Optional private GPU inference service for Plugin Factory chat.
enable_ollama        = false
ollama_ami_id        = ""
ollama_instance_type = "g6.xlarge"
ollama_model         = "qwen3:8b"

vault_mode      = "mock"
vault_auth_mode = "mock"
vault_addr      = ""
vault_namespace = ""

# Real Vault mode examples:
# vault_mode              = "real"
# vault_auth_mode         = "approle"
# vault_addr              = "http://vault.internal:8200"
# vault_namespace         = ""
# vault_role_id_secret_arn = "arn:aws:secretsmanager:..."
# vault_secret_id_secret_arn = "arn:aws:secretsmanager:..."
