#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

log() {
  echo "[$(date --iso-8601=seconds)] $*"
}

log "Installing Vault Enterprise prerequisites"
apt-get update
apt-get install -y ca-certificates curl gpg lsb-release jq awscli

if [ ! -f /usr/share/keyrings/hashicorp-archive-keyring.gpg ]; then
  curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
fi

if [ ! -f /etc/apt/sources.list.d/hashicorp.list ]; then
  echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" > /etc/apt/sources.list.d/hashicorp.list
fi

apt-get update
apt-get install -y vault-enterprise

TOKEN="$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")"
PRIVATE_IP="$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)"
INSTANCE_ID="$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)"

install -d -o vault -g vault -m 0750 /opt/vault/data
install -d -o vault -g vault -m 0750 /opt/vault/plugins
install -d -o vault -g vault -m 0750 /etc/vault.d

log "Fetching Vault Enterprise license from SSM"
aws ssm get-parameter \
  --region "${aws_region}" \
  --name "${vault_license_parameter_name}" \
  --with-decryption \
  --query "Parameter.Value" \
  --output text > /etc/vault.d/vault.hclic
chown vault:vault /etc/vault.d/vault.hclic
chmod 0640 /etc/vault.d/vault.hclic

cat >/etc/vault.d/vault.hcl <<VAULT_CONFIG
ui = true
cluster_name = "${vault_cluster_tag}"
disable_mlock = true
api_addr = "http://$PRIVATE_IP:8200"
cluster_addr = "http://$PRIVATE_IP:8201"
license_path = "/etc/vault.d/vault.hclic"
plugin_directory = "/opt/vault/plugins"

listener "tcp" {
  address = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_disable = true
}

storage "raft" {
  path = "/opt/vault/data"
  node_id = "$INSTANCE_ID"

  retry_join {
    auto_join = "provider=aws region=${aws_region} tag_key=VaultCluster tag_value=${vault_cluster_tag}"
    auto_join_scheme = "http"
    auto_join_port = 8200
  }
}

seal "awskms" {
  region = "${aws_region}"
  kms_key_id = "${kms_key_id}"
}
VAULT_CONFIG

chown vault:vault /etc/vault.d/vault.hcl
chmod 0640 /etc/vault.d/vault.hcl

log "Starting Vault Enterprise"
systemctl enable vault
systemctl restart vault

if [ "${node_index}" = "0" ]; then
  export VAULT_ADDR="http://127.0.0.1:8200"
  log "Waiting for Vault API before initialization"
  for _ in $(seq 1 90); do
    if vault status -format=json >/tmp/vault-status.json 2>/tmp/vault-status.err; then
      break
    fi
    if grep -q '"initialized":false' /tmp/vault-status.json 2>/dev/null; then
      break
    fi
    sleep 5
  done

  if grep -q '"initialized":false' /tmp/vault-status.json 2>/dev/null; then
    log "Initializing Vault and storing init output in SSM SecureString"
    INIT_JSON="$(vault operator init -format=json -recovery-shares=1 -recovery-threshold=1)"
    aws ssm put-parameter \
      --region "${aws_region}" \
      --name "${vault_init_parameter_name}" \
      --type SecureString \
      --overwrite \
      --value "$INIT_JSON" >/dev/null
  else
    log "Vault appears initialized or status was unavailable; skipping init"
  fi
fi

log "Vault Enterprise bootstrap complete"
